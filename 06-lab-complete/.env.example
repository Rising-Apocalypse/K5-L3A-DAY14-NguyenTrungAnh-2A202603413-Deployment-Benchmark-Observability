# cp .env.example .env  (file .env đã nằm trong .gitignore, không commit)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bắt buộc. Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Để trống thì /ask trả 401 cho mọi request.
AGENT_API_KEY=

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
